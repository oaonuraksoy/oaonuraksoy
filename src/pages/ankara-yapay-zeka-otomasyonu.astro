---
import BaseLayout from '../layouts/BaseLayout.astro';

const faqs = [
  {
    question: "Kurumsal yapay zeka otomasyonu nedir ve basit chatbot sarmalayıcılarından (GPT wrapper) farkı nedir?",
    answer: "Piyasadaki yüzeysel chatbot sarmalayıcıları, kontrolsüz metin üreterek halüsinasyon riski taşır ve şirket içi veri güvenliğini tehlikeye atar. Benim kurduğum kurumsal yapay zeka otomasyonu mimarisi; Model Context Protocol (MCP), katı durum makineleri (FSM) ve tip güvenli veri sözleşmelerine dayanır. Müşteri siparişi, randevu akışı, stok sorgulama veya şartname analizi gibi kritik iş süreçleri şirketinizin kurallarına göre deterministik olarak işletilir; yapay zeka asla kurumsal mantığın dışına çıkamaz."
  },
  {
    question: "Santral (PBX) ve telefon hatlarına yapay zeka sesli asistanı nasıl entegre edilir?",
    answer: "Geleneksel tuşlamalı IVR menüleri arayanı dakikalarca bekletip hattı kilitler. Geliştirdiğim VoIP ve SIP ağ dinleme mimarisi (oa_sip_recorder tecrübesiyle); hastaneler, danışmanlık firmaları ve sanayi kuruluşlarında santral akışına bağlanır. Özel HRS Ankara Kadın Hastalıkları ve Doğum Hastanesi için kurulan '9'u Tuşlayın' modelinde olduğu gibi; arayan hasta veya müşterinin niyetini gerçek zamanlı sesli zekayla anlar, ilgili hekim, randevu veya departmana beklemesiz ön yönlendirme sağlar."
  },
  {
    question: "Niyet odaklı (intent-based) canlı destek ve operatör yönetim ekranı nasıl çalışır?",
    answer: "Klasik canlı destek pencereleri mesai saatleri dışında sessiz kalır veya ezbere kopyala-yapıştır mesajlarla kullanıcıyı kaçırır. Niyet odaklı mimari; web sitesine gelen hastanın veya B2B alıcının talebini milisaniyeler içinde sınıflandırır, acil talepleri nöbetçi operatörün ekranına bildirimle düşürürken genel soruları şirket bilgi bankasından anında doğrulanmış yanıtlarla karşılar."
  },
  {
    question: "Şirket içi özel RAG (Retrieval-Augmented Generation) ve bilgi tabanı güvenliği nasıl sağlanır?",
    answer: "Kurumsal dokümanlar, sözleşmeler, ürün teknik çizimleri ve hasta/müşteri kayıtları hiçbir zaman halka açık üçüncü parti yapay zeka eğitim havuzlarına aktarılmaz. Yerel öncelikli (local-first) veya izole özel bulut mimarisi üzerinde, yalnızca firmanıza ait vektör indeksleri ve katı rol tabanlı yetkilendirme (RBAC) ile çalışan özel RAG sistemleri kurulur."
  },
  {
    question: "Yapay Zeka Arama Motorları (GEO / SGE) optimizasyonu neden zorunludur?",
    answer: "Artık müşteriler ve kurumsal satın almacılar sadece Google'da anahtar kelime aratmakla kalmıyor; Perplexity, ChatGPT Arama ve Google AI Overviews gibi yapay zeka motorlarına doğrudan sorular yöneltiyor. Doğrulanmış Schema.org tekil @graph, llms.txt ve semantik varlık otoritesi mimarimiz; yapay zeka arama motorlarının firmanızı birincil otorite kaynak olarak alıntılamasını sağlar."
  }
];

const title = "Ankara Yapay Zeka Ajansı & AI Otomasyonu | Onur Aksoy";
const name = "Ankara Yapay Zeka Ajansı ve Kurumsal AI Otomasyonu Çözümleri";
const description = "Ankara yapay zeka ajansı ve kurumsal yapay zeka otomasyonu: PBX sesli asistanlar, niyet odaklı canlı destek, özel RAG ve GEO otorite sistem mimarisi.";
const counterpartUrl = "/en/ankara-enterprise-ai-automation/";
const ogImage = "https://onuraksoy.com.tr/images/services/ankara-yapay-zeka-otomasyonu.webp";
---

<BaseLayout
  title={title}
  name={name}
  description={description}
  image={ogImage}
  lang="tr"
  counterpartUrl={counterpartUrl}
  schemaType="Service"
  serviceType="Ankara Yapay Zeka Ajansı & Kurumsal Yapay Zeka Otomasyonu"
  faqs={faqs}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-16">
    <!-- Breadcrumb Nav -->
    <nav aria-label="Breadcrumb" class="mb-8">
      <ol class="flex items-center gap-2 text-xs font-mono text-text-muted">
        <li>
          <a href="/" class="hover:text-gold-highlight transition-colors">Ana Sayfa</a>
        </li>
        <li>/</li>
        <li class="text-gold-tungsten font-semibold">Ankara Yapay Zeka Ajansı & Kurumsal AI Otomasyonu</li>
      </ol>
    </nav>

    <!-- Header Section -->
    <header class="pb-12 border-b border-obsidian-border mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-obsidian-surface border border-gold-tungsten/40 text-xs font-mono text-gold-tungsten mb-4">
        <span class="w-2 h-2 rounded-full bg-gold-tungsten animate-pulse"></span>
        <span>Deterministik Yapay Zeka & Kurumsal Otomasyon</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-text-primary leading-tight mb-6">
        Ankara Yapay Zeka Ajansı ve Kurumsal Yapay Zeka Otomasyonu Çözümleri
      </h1>
      <p class="text-lg sm:text-xl text-text-secondary leading-relaxed max-w-3xl font-normal">
        Özel hastaneler, kurumsal şirketler, dijital yayıncılar ve sanayi kuruluşları için; halüsinasyonsuz santral sesli yapay zeka asistanları, niyet odaklı canlı destek operatör ekranları, özel RAG hatları ve GEO varlık otoritesi mimarisi.
      </p>
    </header>

    <!-- Executive Summary Card -->
    <section class="mb-16 p-6 sm:p-8 rounded-2xl bg-obsidian-surface/60 border border-gold-tungsten/30 shadow-xl relative overflow-hidden">
      <div class="absolute -right-12 -top-12 w-48 h-48 bg-gold-tungsten/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="relative z-10">
        <span class="text-xs font-mono uppercase tracking-widest text-gold-tungsten font-semibold block mb-2">
          Mimari Teşhis & Kurumsal Dönüşüm
        </span>
        <p class="text-base text-text-primary leading-relaxed mb-4">
          Geleneksel ajansların sunduğu yüzeysel "yapay zeka chatbot" paketleri, kurumsal şirketlerin iş süreçlerini çözmek yerine yeni güvenlik ve itibar riskleri yaratıyor. Kontrolsüz dil modelleri şirketinizi yanlış temsil edebiliyor, müşteri ve hasta verilerini sızdırabiliyor ve çağrı merkezi kuyruklarını rahatlatmakta yetersiz kalıyor.
        </p>
        <p class="text-sm text-text-muted leading-relaxed">
          Ben; deterministik durum makineleri, Model Context Protocol (MCP) standartları ve VoIP/santral telemetrisi üzerine kurulu egemen yapay zeka sistemleri inşa ediyorum. Özel HRS Ankara Hastanesi ve Tarihçi Anne projelerinde canlıya aldığım gibi; telefon santralinden web portalına ve mobil uygulamalara kadar tüm kanalları birbirine bağlayan, ölçülebilir operasyonel verimlilik sağlayan mühendislik çözümleri sunuyorum.
        </p>
      </div>
    </section>

    <!-- 4 Problem -> Solution Architectural Pillars -->
    <section class="mb-16 space-y-6">
      <div class="mb-2">
        <span class="text-xs font-mono uppercase tracking-widest text-gold-tungsten font-semibold block mb-1">
          Dört Temel Çözüm Sütunu
        </span>
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-text-primary">
          Kurumsal Yapay Zeka Otomasyonunun 4 Mimari Sütunu
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2">
        <!-- Sütun 1: PBX Sesli Asistan -->
        <div class="p-6 rounded-xl bg-obsidian-surface border border-obsidian-border flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="text-xs font-mono text-gold-tungsten font-bold tracking-wider">SÜTUN 01</span>
              <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-gold-tungsten/15 text-gold-highlight border border-gold-tungsten/30">VoIP & PBX</span>
            </div>
            <h3 class="text-lg font-bold text-text-primary mb-2">
              Santral & PBX Gerçek Zamanlı Sesli Yapay Zeka Asistanı
            </h3>
            <p class="text-xs sm:text-sm text-text-muted leading-relaxed mb-4">
              Arayan hastaların veya müşterilerin saatlerce hantal tuşlu IVR menülerinde beklemesini engeller. Telefon santraline bağlanan sesli yapay zeka; arayanın niyetini anında analiz eder, hekim branşlarına veya ilgili birimlere sıfır gecikmeyle ön yönlendirme sağlar.
            </p>
            <div class="p-3 rounded-lg bg-obsidian-black border border-obsidian-border/70 text-xs font-mono text-gold-highlight">
              Saha Kanıtı: Özel HRS Ankara Hastanesi telefon santralinde "9'u Tuşlayın" akışıyla canlı kullanımda.
            </div>
          </div>
          <div class="mt-6 pt-4 border-t border-obsidian-border/50 text-xs font-mono text-emerald-400">
            Çağrı Kuyruklarında %40+ Rahatlama
          </div>
        </div>

        <!-- Sütun 2: Niyet Odaklı Canlı Destek -->
        <div class="p-6 rounded-xl bg-obsidian-surface border border-obsidian-border flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="text-xs font-mono text-gold-tungsten font-bold tracking-wider">SÜTUN 02</span>
              <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-emerald-950/40 text-emerald-400 border border-emerald-800/40">Canlı Destek</span>
            </div>
            <h3 class="text-lg font-bold text-text-primary mb-2">
              Niyet Odaklı Akıllı Canlı Destek & Operatör Yönetim Ekranı
            </h3>
            <p class="text-xs sm:text-sm text-text-muted leading-relaxed mb-4">
              Web sitesi ve hasta portalı ziyaretçilerinin sorularını anlık niyet analiziyle filtreleyen akıllı asistan. Genel randevu ve kurum sorularını anında karşılarken, kritik talepleri nöbetçi operatör ekranına anlık sesli ve görsel bildirimle aktarır.
            </p>
            <div class="p-3 rounded-lg bg-obsidian-black border border-obsidian-border/70 text-xs font-mono text-emerald-400">
              Saha Kanıtı: Mesai dışı saatlerde sağlık turizmi hastalarına 24/7 çok dilli kesintisiz erişim.
            </div>
          </div>
          <div class="mt-6 pt-4 border-t border-obsidian-border/50 text-xs font-mono text-text-primary">
            7/24 Kesintisiz Hasta & Müşteri Yanıtı
          </div>
        </div>

        <!-- Sütun 3: Özel RAG & MCP -->
        <div class="p-6 rounded-xl bg-obsidian-surface border border-obsidian-border flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="text-xs font-mono text-gold-tungsten font-bold tracking-wider">SÜTUN 03</span>
              <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-sky-950/40 text-sky-400 border border-sky-800/40">Özel RAG & MCP</span>
            </div>
            <h3 class="text-lg font-bold text-text-primary mb-2">
              Özel Bilgi Tabanı RAG & Deterministik İş Akışları
            </h3>
            <p class="text-xs sm:text-sm text-text-muted leading-relaxed mb-4">
              Şirketinizin teknik dokümanları, fiyat listeleri, mevzuat arşivleri ve sözleşmelerini izole vektör tabanlarında güvenle işleyin. Model Context Protocol (MCP) standartlarıyla ERP ve veritabanı sistemlerinize bağlanan deterministik yapay zeka ajanları.
            </p>
            <div class="p-3 rounded-lg bg-obsidian-black border border-obsidian-border/70 text-xs font-mono text-sky-400">
              Güvenlik: Şirket verisi üçüncü parti model eğitim havuzlarına asla gönderilmez.
            </div>
          </div>
          <div class="mt-6 pt-4 border-t border-obsidian-border/50 text-xs font-mono text-gold-tungsten">
            Sıfır Halüsinasyon • Tam Veri Egemenliği
          </div>
        </div>

        <!-- Sütun 4: GEO & Varlık Otoritesi -->
        <div class="p-6 rounded-xl bg-obsidian-surface border border-obsidian-border flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="text-xs font-mono text-gold-tungsten font-bold tracking-wider">SÜTUN 04</span>
              <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-purple-950/40 text-purple-400 border border-purple-800/40">GEO & SGE</span>
            </div>
            <h3 class="text-lg font-bold text-text-primary mb-2">
              GEO Varlık Otoritesi & Üretken Arama Motoru Optimizasyonu
            </h3>
            <p class="text-xs sm:text-sm text-text-muted leading-relaxed mb-4">
              Perplexity, ChatGPT Arama ve Google AI Overviews gibi yapay zeka yanıt sistemlerinde markanızı birincil otorite kaynağı yapın. Tekil Schema.org @graph ve /llms.txt protokolleriyle modellerin firmanızı doğrudan referans göstermesini sağlayın.
            </p>
            <div class="p-3 rounded-lg bg-obsidian-black border border-obsidian-border/70 text-xs font-mono text-purple-300">
              Saha Kanıtı: Tarihçi Anne / Seda Aksoy projesinde Google SERP ve GEO yanıtlarında #1 birincil kaynak.
            </div>
          </div>
          <div class="mt-6 pt-4 border-t border-obsidian-border/50 text-xs font-mono text-emerald-400">
            Yapay Zeka Aramalarında #1 Otorite Kaynağı
          </div>
        </div>
      </div>
    </section>

    <!-- 5 Strategic Sectors Grid -->
    <section class="mb-16 space-y-6">
      <div class="mb-2">
        <span class="text-xs font-mono uppercase tracking-widest text-gold-tungsten font-semibold block mb-1">
          Sektörel Uygulama Alanları
        </span>
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-text-primary">
