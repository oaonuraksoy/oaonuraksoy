---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const broadcasts = await getCollection('broadcasts', ({ data }) => data.lang === 'tr');
broadcasts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

// Featured broadcast (first one or featured: true)
const featuredBroadcast = broadcasts.find((b) => b.data.featured) || broadcasts[0];

// Extract all unique tags
const allTags = Array.from(new Set(broadcasts.flatMap((b) => b.data.tags || [])));

// Counts for format filters
const countAll = broadcasts.length;
const countVideo = broadcasts.filter((b) => !!b.data.youtubeId).length;
const countAudio = broadcasts.filter((b) => !!b.data.spotifyUrl).length;
const countVault = broadcasts.filter((b) => b.data.downloads && b.data.downloads.length > 0).length;
const countArticle = broadcasts.filter((b) => !b.data.youtubeId && !b.data.spotifyUrl).length;

const title = "Yayınlar & Bilgi Kasası — Onur Aksoy";
const description = "Teknik ekran kayıtları, derin mimari transkriptler, interaktif zaman damgalı bölümler ve yüksek hızlı mimari kaynaklar.";
---

<BaseLayout lang="tr" activeNav="broadcasts" title={title} description={description}>

  <main class="max-w-6xl mx-auto px-4 sm:px-6 py-12 sm:py-16 space-y-12">
    <!-- Hero Header -->
    <section class="space-y-4 max-w-3xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-obsidian-surface border border-obsidian-border text-xs font-mono text-gold-tungsten">
        <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
        <span>Yayınlar & Bilgi Kasası</span>
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-text-primary">
        Teknik Yayınlar, Derin Transkriptler & İndirilebilir Kaynaklar.
      </h1>
      <p class="text-base sm:text-lg text-text-muted leading-relaxed">
        Doğrudan makineye ve koda inen mimari incelemeler. Her yayın; YouTube video analizini, tam metin transkriptleri, saniye bazlı bölümleri ve 20TB Google Drive kasasından doğrudan indirilebilir kaynak kod ve şemaları barındırır.
      </p>
    </section>

    <!-- Spotlight Öne Çıkan Yayın Vitrini -->
    {featuredBroadcast && (
      <section class="relative rounded-2xl border border-gold-tungsten/40 bg-gradient-to-br from-obsidian-surface via-obsidian-surface to-obsidian-black p-6 sm:p-8 shadow-2xl overflow-hidden group">
        <div class="absolute -right-20 -top-20 w-80 h-80 bg-gold-tungsten/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <!-- Thumbnail Side -->
          <div class="lg:col-span-6 relative aspect-video rounded-xl overflow-hidden border border-obsidian-border bg-obsidian-black">
            <img
              src={featuredBroadcast.data.youtubeId 
                ? `https://i.ytimg.com/vi/${featuredBroadcast.data.youtubeId}/maxresdefault.jpg`
                : featuredBroadcast.data.thumbnail || '/images/oa-logo.webp'}
              alt={featuredBroadcast.data.title}
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105 opacity-90"
              loading="eager"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-obsidian-black/90 via-transparent to-transparent"></div>

            <div class="absolute top-3 left-3 px-3 py-1 rounded-full bg-gold-tungsten text-obsidian-black text-[11px] font-mono font-bold tracking-wider uppercase shadow">
              ★ Öne Çıkan Yayın
            </div>

            {featuredBroadcast.data.duration && (
              <div class="absolute bottom-3 right-3 px-2 py-0.5 rounded bg-obsidian-black/90 border border-obsidian-border text-xs font-mono text-gold-tungsten">
                {featuredBroadcast.data.duration.replace('PT', '').toLowerCase()}
              </div>
            )}
          </div>

          <!-- Content Side -->
          <div class="lg:col-span-6 space-y-4">
            <div class="flex items-center gap-3 text-xs font-mono text-text-muted">
              <time datetime={featuredBroadcast.data.pubDate.toISOString()} class="text-gold-tungsten">
                {featuredBroadcast.data.pubDate.toLocaleDateString('tr-TR', { year: 'numeric', month: 'short', day: 'numeric' })}
              </time>
              <span>•</span>
              <span class="text-gold-highlight">Son Çıkan</span>
              {featuredBroadcast.data.downloads && featuredBroadcast.data.downloads.length > 0 && (
                <>
                  <span>•</span>
                  <span class="text-gold-tungsten">{featuredBroadcast.data.downloads.length} Kasa İndirmesi</span>
                </>
              )}
            </div>

            <h2 class="text-xl sm:text-2xl lg:text-3xl font-bold text-text-primary group-hover:text-gold-highlight transition-colors">
              <a href={`/tr/broadcasts/${featuredBroadcast.id.replace(/^tr\//, '')}/`}>
                {featuredBroadcast.data.title}
              </a>
            </h2>

            <p class="text-sm sm:text-base text-text-muted line-clamp-3 leading-relaxed">
              {featuredBroadcast.data.description}
            </p>

            <div class="flex items-center gap-2 flex-wrap pt-2">
              {featuredBroadcast.data.tags.map((tag) => (
                <span class="text-xs font-mono text-text-muted px-2.5 py-0.5 rounded bg-obsidian-black border border-obsidian-border">
                  #{tag}
                </span>
              ))}
            </div>

            <div class="pt-4 flex items-center gap-4">
              <a
                href={`/tr/broadcasts/${featuredBroadcast.id.replace(/^tr\//, '')}/`}
                class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-lg bg-gold-tungsten text-obsidian-black font-semibold text-xs hover:bg-gold-highlight transition-all duration-200 shadow-lg shadow-gold-tungsten/20"
              >
                <span>Tüm Yayını İncele</span>
                <span>→</span>
              </a>
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- Kategori & Format Filtreleme Merkezi -->
    <section class="space-y-6 pt-4 border-t border-obsidian-border/60">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <!-- Format Filtre Sekmeleri -->
        <div class="flex items-center gap-2 flex-wrap" role="group" aria-label="Format filtreleri">
          <button
            type="button"
            class="filter-tab px-3.5 py-1.5 rounded-lg text-xs font-mono font-medium transition-all bg-gold-tungsten text-obsidian-black font-semibold shadow-sm"
            data-filter="all"
          >
            Tüm Yayınlar <span class="opacity-80">({countAll})</span>
          </button>
          <button
            type="button"
            class="filter-tab px-3.5 py-1.5 rounded-lg text-xs font-mono font-medium transition-all bg-obsidian-surface border border-obsidian-border text-text-muted hover:text-text-primary"
            data-filter="video"
          >
            🎬 Screencast & Video <span class="opacity-80">({countVideo})</span>
          </button>
          <button
            type="button"
            class="filter-tab px-3.5 py-1.5 rounded-lg text-xs font-mono font-medium transition-all bg-obsidian-surface border border-obsidian-border text-text-muted hover:text-text-primary"
            data-filter="audio"
          >
            🎙️ Podcast & Ses <span class="opacity-80">({countAudio})</span>
          </button>
          <button
            type="button"
            class="filter-tab px-3.5 py-1.5 rounded-lg text-xs font-mono font-medium transition-all bg-obsidian-surface border border-obsidian-border text-text-muted hover:text-text-primary"
            data-filter="vault"
          >
            📦 Bilgi Kasası (İndirmeler) <span class="opacity-80">({countVault})</span>
          </button>
          <button
            type="button"
            class="filter-tab px-3.5 py-1.5 rounded-lg text-xs font-mono font-medium transition-all bg-obsidian-surface border border-obsidian-border text-text-muted hover:text-text-primary"
            data-filter="article"
          >
            📄 Makaleler <span class="opacity-80">({countArticle})</span>
          </button>
        </div>

        <!-- Sonuç Durumu -->
        <div class="text-xs font-mono text-text-muted" id="filter-status" aria-live="polite">
          Toplam <span id="visible-count">{broadcasts.length}</span> yayın listeleniyor
        </div>
      </div>

      <!-- Konu Etiketleri -->
      {allTags.length > 0 && (
        <div class="flex items-center gap-1.5 flex-wrap pt-1">
          <span class="text-xs font-mono text-gold-tungsten mr-1">Konular:</span>
          {allTags.map((tag) => (
            <button
              type="button"
              class="tag-pill text-[11px] font-mono text-text-muted hover:text-gold-highlight px-2 py-0.5 rounded bg-obsidian-surface border border-obsidian-border hover:border-gold-tungsten/40 transition-colors"
              data-tag={tag.toLowerCase()}
            >
              #{tag}
            </button>
          ))}
        </div>
      )}
    </section>

    <!-- Yayınlar Grid Listesi -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-8" id="broadcasts-grid">
      {broadcasts.map((item) => {
        const slug = item.id.replace(/^tr\//, '');
        const thumbUrl = item.data.youtubeId 
          ? `https://i.ytimg.com/vi/${item.data.youtubeId}/maxresdefault.jpg`
          : item.data.thumbnail || '/images/oa-logo.webp';

        const formats: string[] = ['all'];
        if (item.data.youtubeId) formats.push('video');
        if (item.data.spotifyUrl) formats.push('audio');
        if (item.data.downloads && item.data.downloads.length > 0) formats.push('vault');
        if (!item.data.youtubeId && !item.data.spotifyUrl) formats.push('article');

        const tagsString = (item.data.tags || []).map((t) => t.toLowerCase()).join(' ');

        return (
          <article
            class="broadcast-card group flex flex-col rounded-xl border border-obsidian-border bg-obsidian-surface hover:border-gold-tungsten/60 transition-all duration-300 overflow-hidden shadow-lg hover:shadow-gold-tungsten/5"
            data-formats={formats.join(' ')}
            data-tags={tagsString}
          >
            <!-- Thumbnail & Video Rozeti -->
            <a href={`/tr/broadcasts/${slug}/`} class="relative aspect-video overflow-hidden bg-obsidian-black block">
              <img
                src={thumbUrl}
                alt={item.data.title}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105 opacity-85 group-hover:opacity-100"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-obsidian-black/80 via-transparent to-transparent"></div>
              
              {item.data.duration && (
                <div class="absolute bottom-3 right-3 px-2 py-0.5 rounded bg-obsidian-black/90 border border-obsidian-border text-[11px] font-mono text-gold-tungsten">
                  {item.data.duration.replace('PT', '').toLowerCase()}
                </div>
              )}

              <div class="absolute top-3 left-3 flex items-center gap-1.5">
                {item.data.youtubeId && (
                  <span class="px-2 py-0.5 rounded-md bg-red-600/90 text-white text-[10px] font-semibold flex items-center gap-1 shadow">
                    <svg class="w-3 h-3 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                    </svg>
                    <span>Video</span>
                  </span>
                )}
                {item.data.spotifyUrl && (
                  <span class="px-2 py-0.5 rounded-md bg-emerald-600/90 text-white text-[10px] font-semibold flex items-center gap-1 shadow">
                    <span>Podcast</span>
                  </span>
                )}
                {item.data.downloads && item.data.downloads.length > 0 && (
                  <span class="px-2 py-0.5 rounded-md bg-amber-600/90 text-white text-[10px] font-semibold flex items-center gap-1 shadow">
                    <span>Kasa</span>
                  </span>
                )}
                {!item.data.youtubeId && !item.data.spotifyUrl && (
                  <span class="px-2 py-0.5 rounded-md bg-blue-600/90 text-white text-[10px] font-semibold flex items-center gap-1 shadow">
                    <span>Makale</span>
                  </span>
                )}
              </div>
            </a>

            <!-- Card Body -->
            <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
              <div class="space-y-2.5">
                <div class="flex items-center gap-3 text-xs text-text-muted font-mono">
                  <time datetime={item.data.pubDate.toISOString()}>
                    {item.data.pubDate.toLocaleDateString('tr-TR', { year: 'numeric', month: 'short', day: 'numeric' })}
                  </time>
                  <span>•</span>
                  <span>{item.data.chapters?.length || 0} Bölüm</span>
                  {item.data.downloads && item.data.downloads.length > 0 && (
                    <>
                      <span>•</span>
                      <span class="text-gold-tungsten">{item.data.downloads.length} Kasa İndirmesi</span>
                    </>
                  )}
                </div>

                <h2 class="text-lg sm:text-xl font-bold text-text-primary group-hover:text-gold-highlight transition-colors line-clamp-2">
                  <a href={`/tr/broadcasts/${slug}/`}>
                    {item.data.title}
                  </a>
                </h2>

                <p class="text-sm text-text-muted line-clamp-3 leading-relaxed">
                  {item.data.description}
                </p>
              </div>

              <div class="pt-2 flex items-center justify-between border-t border-obsidian-border/60">
                <div class="flex items-center gap-1.5 flex-wrap">
                  {item.data.tags.slice(0, 3).map((tag) => (
                    <span class="text-[11px] font-mono text-text-muted px-2 py-0.5 rounded bg-obsidian-black border border-obsidian-border">
                      #{tag}
                    </span>
                  ))}
                </div>

                <a
                  href={`/tr/broadcasts/${slug}/`}
                  class="text-xs font-semibold text-gold-tungsten group-hover:text-gold-highlight flex items-center gap-1 transition-colors"
                >
                  <span>Yayını İncele</span>
                  <span>→</span>
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </section>

    <!-- Boş Durum (Filtre Sonucu Bulunamadığında) -->
    <div id="empty-state" class="hidden p-12 text-center rounded-xl border border-obsidian-border bg-obsidian-surface space-y-3">
      <div class="text-gold-tungsten font-mono text-sm font-semibold">Yayın Bulunamadı</div>
      <p class="text-xs text-text-muted">Seçtiğiniz formata veya etikete uygun yayın henüz bulunmuyor.</p>
      <button
        type="button"
        id="reset-filter-btn"
        class="inline-block px-3.5 py-1.5 rounded-md bg-gold-tungsten/15 text-gold-highlight hover:bg-gold-tungsten hover:text-obsidian-black border border-gold-tungsten/30 text-xs font-mono font-semibold transition-all"
      >
        Filtreleri Sıfırla
      </button>
    </div>
  </main>
</BaseLayout>

<script>
  // Sıfır bağımlılıklı anlık filtreleme motoru
  const filterTabs = document.querySelectorAll<HTMLButtonElement>('.filter-tab');
  const tagPills = document.querySelectorAll<HTMLButtonElement>('.tag-pill');
  const cards = document.querySelectorAll<HTMLElement>('.broadcast-card');
  const visibleCountEl = document.getElementById('visible-count');
  const emptyStateEl = document.getElementById('empty-state');
  const resetBtn = document.getElementById('reset-filter-btn');

  let currentFilter = 'all';
  let currentTag = '';

  function applyFilters() {
    let visible = 0;

    cards.forEach((card) => {
      const formats = (card.getAttribute('data-formats') || '').split(' ');
      const tags = (card.getAttribute('data-tags') || '').split(' ');

      const formatMatches = currentFilter === 'all' || formats.includes(currentFilter);
      const tagMatches = !currentTag || tags.includes(currentTag);

      if (formatMatches && tagMatches) {
        card.classList.remove('hidden');
        visible++;
      } else {
        card.classList.add('hidden');
      }
    });

    if (visibleCountEl) {
      visibleCountEl.textContent = visible.toString();
    }

    if (emptyStateEl) {
      if (visible === 0) {
        emptyStateEl.classList.remove('hidden');
      } else {
        emptyStateEl.classList.add('hidden');
      }
    }
  }

  filterTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      filterTabs.forEach((t) => {
        t.className = 'filter-tab px-3.5 py-1.5 rounded-lg text-xs font-mono font-medium transition-all bg-obsidian-surface border border-obsidian-border text-text-muted hover:text-text-primary';
      });
      tab.className = 'filter-tab px-3.5 py-1.5 rounded-lg text-xs font-mono font-medium transition-all bg-gold-tungsten text-obsidian-black font-semibold shadow-sm';

      currentFilter = tab.getAttribute('data-filter') || 'all';
      applyFilters();
    });
  });

  tagPills.forEach((pill) => {
    pill.addEventListener('click', () => {
      const clickedTag = pill.getAttribute('data-tag') || '';
      if (currentTag === clickedTag) {
        currentTag = '';
        pill.classList.remove('bg-gold-tungsten', 'text-obsidian-black');
        pill.classList.add('text-text-muted');
      } else {
        tagPills.forEach((p) => {
          p.classList.remove('bg-gold-tungsten', 'text-obsidian-black');
          p.classList.add('text-text-muted');
        });
        currentTag = clickedTag;
        pill.classList.remove('text-text-muted');
        pill.classList.add('bg-gold-tungsten', 'text-obsidian-black');
      }
      applyFilters();
    });
  });

  if (resetBtn) {
    resetBtn.addEventListener('click', () => {
      currentFilter = 'all';
      currentTag = '';
      filterTabs[0]?.click();
      tagPills.forEach((p) => {
        p.classList.remove('bg-gold-tungsten', 'text-obsidian-black');
        p.classList.add('text-text-muted');
      });
      applyFilters();
    });
  }
</script>
