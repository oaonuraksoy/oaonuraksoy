---
import BaseLayout from '../../layouts/BaseLayout.astro';

const directChannels = [
  {
    name: 'Birincil E-Posta',
    handle: 'dev@onuraksoy.com.tr',
    href: 'mailto:dev@onuraksoy.com.tr',
    desc: 'Resmi teklifler, mimari danışmanlık ve proje işbirlikleri için.'
  },
  {
    name: 'Telegram Kanalı',
    handle: '@oaonuraksoy',
    href: 'https://t.me/oaonuraksoy',
    desc: 'Hızlı ve şifreli doğrudan mesajlaşma.'
  },
  {
    name: 'WhatsApp Hattı',
    handle: '+90 551 181 70 53',
    href: 'https://wa.me/905511817053',
    desc: 'Öncelikli görüşmeler ve proje senkronizasyonları için anlık iletişim.'
  },
  {
    name: 'LinkedIn Profili',
    handle: 'in/oaonuraksoy',
    href: 'https://linkedin.com/in/oaonuraksoy',
    desc: 'Profesyonel geçmiş, referanslar ve kurumsal ağ.'
  },
  {
    name: 'GitHub Depoları',
    handle: 'github.com/oaonuraksoy',
    href: 'https://github.com/oaonuraksoy',
    desc: 'Açık kaynak katkıları, teknik depolar ve mimari örnekler.'
  },
  {
    name: 'X (Twitter)',
    handle: '@oaonuraksoy',
    href: 'https://x.com/oaonuraksoy',
    desc: 'Halka açık paylaşımlar, teknoloji analizleri ve mimari notlar.'
  }
];

const faqs = [
  {
    question: "Yazılım mimarisi ve teknik danışmanlık süreçleriniz nasıl işliyor?",
    answer: "İş birliklerimizi üç temel modelde yürütüyoruz: (1) Sabit kapsamlı teknik denetim (audit) ve mimari analiz sprinti, (2) Uçtan uca özel sistem geliştirme (.NET/WPF masaüstü, yerel öncelikli POS altyapıları, web2app paketleme), ve (3) Büyüyen mühendislik ekipleri için dönemsel sistem mimarlığı danışmanlığı. Süreç, net teknik gereksinimlerin ve metriklerin belirlendiği keşif görüşmesiyle başlar."
  },
  {
    question: "Mevcut sistemlere yerel öncelikli (local-first) masaüstü altyapısı entegre edilebilir mi?",
    answer: "Evet. İster eski kurumsal sistemleri modernize ediyor olun ister sıfırdan inşa edin; gömülü SQLite/PostgreSQL depolama, ham TCP/IP yerel ağ (LAN) soket senkronizasyonu ve sıfır bulut bağımlılığı sunan yerel öncelikli mimariler tasarlıyorum. İnternet kesintilerinde bile sistem sıfır gecikmeyle çalışmaya devam eder ve ağ sağlandığında deterministik biçimde senkronize olur."
  },
  {
    question: "Yapay zeka ve deterministik ajan sistemleri denetimi ne kadar sürer?",
    answer: "Büyük dil modeli (LLM) pipeline'ları ve otonom ajan sistemlerine yönelik kapsamlı mimari denetimler genellikle 3 ila 7 iş günü sürer; gecikme darboğazlarını, token maliyetlerini ve halüsinasyon koruma açıklarını detaylandıran uygulanabilir bir rapor sunulur. Özel deterministik ajan pipeline uygulamaları ise entegrasyon kapsamına bağlı olarak 2 ila 4 hafta arasında tamamlanır."
  },
  {
    question: "Acil bir proje veya danışmanlık için nasıl hızlı bağlantı kurabilirim?",
    answer: "Teknik gereksinimlerinizi, sistem darboğazlarınızı ve hedeflerinizi özetleyen bir mesajı dev@onuraksoy.com.tr adresine iletebilirsiniz. Anlık ve öncelikli iletişim için Telegram (@oaonuraksoy) veya WhatsApp (+90 551 181 70 53) üzerinden doğrudan mesaj gönderebilirsiniz. Tüm taleplere 24 saat içinde dönüş sağlanır."
  }
];
---

<BaseLayout
  title="İletişim & Doğrudan Bağlantı — Onur Aksoy"
  description="Onur Aksoy ile doğrudan iletişim kanalları. Kritik yazılım projeleri, yapay zeka sistem mimarileri ve masaüstü yazılım işbirlikleri."
  lang="tr"
  activeNav="contact"
  faqs={faqs}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-16">
    <!-- Header -->
    <div class="mb-14 max-w-2xl">
      <span class="text-xs font-mono tracking-widest text-gold-tungsten uppercase font-semibold">
        Doğrudan İletişim Hattı
      </span>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-text-primary mt-2 mb-4">
        Bağlantı Kurun
      </h1>
      <p class="text-base text-text-muted leading-relaxed">
        Yüksek dirençli mimariler, deterministik yapay zeka pipeline'ları ve kesintisiz masaüstü yazılımları inşa etmek isteyen kurucular ve ürün ekipleriyle çalışıyorum.
      </p>
    </div>

    <!-- Primary Email Featured Hero Box -->
    <div class="p-8 sm:p-10 rounded-2xl bg-obsidian-surface border border-gold-tungsten/40 shadow-2xl mb-12">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6">
        <div>
          <span class="text-xs font-mono uppercase tracking-wider text-gold-highlight font-semibold">
            Merkezi İletişim Geçidi
          </span>
          <div class="mt-2 text-2xl sm:text-3xl font-mono font-bold text-text-primary">
            dev@onuraksoy.com.tr
          </div>
          <p class="text-xs text-text-muted mt-2">
            Günlük kontrol edilir • Standart yanıt süresi &lt; 24 saat
          </p>
        </div>

        <a
          href="mailto:dev@onuraksoy.com.tr"
          class="inline-flex items-center justify-center px-6 py-3 rounded-lg bg-gold-tungsten text-obsidian-black font-semibold text-sm hover:bg-gold-highlight transition-all shadow-md"
        >
          E-Posta Gönder &rarr;
        </a>
      </div>
    </div>

    <!-- Direct Channels Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-16">
      {directChannels.map((channel) => (
        <a
          href={channel.href}
          target="_blank"
          rel="noopener noreferrer"
          class="card-noir p-6 rounded-xl block group"
        >
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-mono font-bold text-gold-tungsten group-hover:text-gold-highlight uppercase">
              {channel.name}
            </span>
            <span class="text-xs text-text-dim group-hover:text-gold-highlight transition-colors">
              ↗
            </span>
          </div>
          <div class="text-base font-mono font-semibold text-text-primary group-hover:text-gold-highlight transition-colors mb-2">
            {channel.handle}
          </div>
          <p class="text-xs text-text-muted leading-relaxed">
            {channel.desc}
          </p>
        </a>
      ))}
    </div>

    <!-- Advisory Protocols -->
    <div class="p-8 rounded-2xl bg-obsidian-surface/60 border border-obsidian-border">
      <h3 class="text-lg font-bold text-text-primary mb-3">
        Çalışma Alanları & Kapsam
      </h3>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 text-xs text-text-muted pt-2">
        <div>
          <strong class="text-text-primary block mb-1">1. Özel Masaüstü Sistemleri</strong>
          .NET/WPF ile yerel ağ soket senkronizasyonlu, sıfır bulut bağımlı yüksek hızlı çözümler.
        </div>
        <div>
          <strong class="text-text-primary block mb-1">2. Yapay Zeka Ajan Mimarisi</strong>
          Katı doğrulama döngüleriyle donatılmış, halüsinasyonsuz otonom iş akışı orkestrasyonu.
        </div>
        <div>
          <strong class="text-text-primary block mb-1">3. Mimari Denetim (Audit)</strong>
          Mevcut kod tabanlarının bellek, gecikme ve güvenlik kırılganlıkları açısından sıfır-güven incelemesi.
        </div>
      </div>
    </div>

    <!-- Sıkça Sorulan Sorular -->
    <div class="mt-16 pt-12 border-t border-obsidian-border">
      <div class="mb-8">
        <span class="text-xs font-mono tracking-widest text-gold-tungsten uppercase font-semibold">
          İletişim & Danışmanlık SSS
        </span>
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-text-primary mt-1">
          Sıkça Sorulan Sorular
        </h2>
        <p class="text-sm text-text-muted mt-1">
          İş birliği modelleri, yerel öncelikli sistemler ve yapay zeka mimarisi süreçlerine dair doğrudan yanıtlar.
        </p>
      </div>

      <div class="space-y-4">
        {faqs.map((faq) => (
          <details class="group p-5 rounded-xl bg-obsidian-surface border border-obsidian-border hover:border-gold-tungsten/40 transition-colors">
            <summary class="flex items-center justify-between font-bold text-text-primary cursor-pointer list-none text-base group-open:text-gold-highlight transition-colors">
              <span>{faq.question}</span>
              <span class="ml-4 text-xs font-mono px-2 py-0.5 rounded bg-obsidian-black border border-obsidian-border text-gold-tungsten group-open:rotate-45 transition-transform duration-200">
                +
              </span>
            </summary>
            <div class="mt-4 pt-4 border-t border-obsidian-border/50 text-sm text-text-muted leading-relaxed">
              {faq.answer}
            </div>
          </details>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
