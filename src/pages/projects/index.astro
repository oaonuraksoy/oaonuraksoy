---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllProjects } from '../../utils/projects';

const projects = await getAllProjects('en');
---

<BaseLayout
  title="Flagship Projects & Architecture Case Studies — Onur Aksoy"
  description="Explore production-certified desktop applications, local-first distributed systems, and generative AI media pipelines developed by Onur Aksoy."
  lang="en"
  activeNav="projects"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-16">
    <!-- Header -->
    <div class="mb-14 max-w-2xl">
      <span class="text-xs font-mono tracking-widest text-gold-tungsten uppercase font-semibold">
        Project Index
      </span>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-text-primary mt-2 mb-4">
        Projects & System Case Studies
      </h1>
      <p class="text-base text-text-muted leading-relaxed">
        Production-certified desktop platforms, browser-native containerization engines, and generative AI pipelines built with high-availability, local-first principles.
      </p>
    </div>

    <!-- Projects List -->
    <div class="space-y-10">
      {projects.map((project) => (
        <article class="card-noir rounded-2xl p-6 sm:p-10">
          <div class="flex flex-col lg:flex-row lg:items-start justify-between gap-6 mb-6">
            <div>
              <div class="flex flex-wrap items-center gap-3 mb-3">
                <span class="text-xs font-mono font-semibold px-2.5 py-1 rounded bg-obsidian-subtle text-gold-highlight border border-obsidian-border">
                  {project.status}
                </span>
                <span class="text-xs font-mono text-text-dim">
                  {project.period}
                </span>
                <span class="text-xs text-text-dim">•</span>
                <span class="text-xs text-text-muted font-medium">
                  {project.role}
                </span>
              </div>

              <h2 class="text-2xl sm:text-3xl font-bold text-text-primary hover:text-gold-highlight transition-colors">
                <a href={`/projects/${project.slug}/`}>
                  {project.title}
                </a>
              </h2>
            </div>

            <!-- Direct External Actions -->
            <div class="flex flex-wrap items-center gap-3 self-start">
              {project.links?.store && (
                <a
                  href={project.links.store}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-xs font-semibold px-3 py-1.5 rounded-md bg-gold-tungsten/15 text-gold-highlight border border-gold-tungsten/30 hover:bg-gold-tungsten hover:text-obsidian-black transition-all"
                >
                  Microsoft Store ↗
                </a>
              )}
              {project.links?.live && (
                <a
                  href={project.links.live}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-xs font-semibold px-3 py-1.5 rounded-md bg-gold-tungsten/15 text-gold-highlight border border-gold-tungsten/30 hover:bg-gold-tungsten hover:text-obsidian-black transition-all"
                >
                  Live Platform ↗
                </a>
              )}
              {project.links?.tool && (
                <a
                  href={project.links.tool}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-xs font-semibold px-3 py-1.5 rounded-md bg-gold-tungsten/15 text-gold-highlight border border-gold-tungsten/30 hover:bg-gold-tungsten hover:text-obsidian-black transition-all"
                >
                  Launch Tool ↗
                </a>
              )}
            </div>
          </div>

          <p class="text-sm sm:text-base text-text-muted leading-relaxed mb-8 max-w-4xl">
            {project.description}
          </p>

          <!-- Metrics -->
          {project.metrics && project.metrics.length > 0 && (
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 p-5 rounded-xl bg-obsidian-black border border-obsidian-border mb-8 max-w-3xl">
              {project.metrics.map((m) => (
                <div>
                  <div class="text-[11px] sm:text-xs text-text-dim font-mono leading-tight mb-1">{m.label}</div>
                  <div class="text-sm sm:text-base font-bold text-gold-highlight">{m.value}</div>
                </div>
              ))}
            </div>
          )}

          <!-- Tags & Case Study Read CTA -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pt-6 border-t border-obsidian-border/60">
            <div class="flex flex-wrap gap-2">
              {project.tags.map((tag) => (
                <span class="text-xs font-mono px-2.5 py-0.5 rounded bg-obsidian-surface border border-obsidian-border text-text-dim">
                  {tag}
                </span>
              ))}
            </div>

            <a
              href={`/projects/${project.slug}/`}
              class="text-sm font-bold text-gold-tungsten hover:text-gold-highlight flex items-center gap-1.5 transition-colors"
            >
              Deep-Dive Technical Case Study &rarr;
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
