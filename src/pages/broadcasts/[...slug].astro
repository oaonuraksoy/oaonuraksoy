---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LiteYouTube from '../../components/LiteYouTube.astro';
import DriveDownloadCard from '../../components/DriveDownloadCard.astro';
import BroadcastJsonLd from '../../components/BroadcastJsonLd.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const enBroadcasts = await getCollection('broadcasts', ({ data }) => data.lang === 'en');
  const trBroadcasts = await getCollection('broadcasts', ({ data }) => data.lang === 'tr');

  return enBroadcasts.map((item) => {
    const slug = item.id.replace(/^en\//, '');
    const trCounterpart = trBroadcasts.find((tr) => tr.data.ref === item.data.ref);
    const counterpartSlug = trCounterpart ? trCounterpart.id.replace(/^tr\//, '') : null;

    return {
      params: { slug },
      props: { item, counterpartSlug }
    };
  });
}

const { item, counterpartSlug } = Astro.props;
const { Content } = await render(item);

const canonicalUrl = `https://onuraksoy.com.tr/broadcasts/${Astro.params.slug}/`;
const ogImage = item.data.youtubeId
  ? `https://i.ytimg.com/vi/${item.data.youtubeId}/maxresdefault.jpg`
  : item.data.thumbnail
    ? (item.data.thumbnail.startsWith('http') ? item.data.thumbnail : `https://onuraksoy.com.tr${item.data.thumbnail}`)
    : 'https://onuraksoy.com.tr/images/onur-aksoy-og.jpg';
const counterpartUrl = counterpartSlug ? `/tr/broadcasts/${counterpartSlug}/` : '/tr/broadcasts/';

const hasVideo = !!item.data.youtubeId;
const hasAudio = !!item.data.spotifyUrl;
const hasDownloads = !!(item.data.downloads && item.data.downloads.length > 0);
---

<BaseLayout
  title={`${item.data.title} — Onur Aksoy Broadcasts`}
  description={item.data.description}
  image={ogImage}
  lang="en"
  activeNav="broadcasts"
  counterpartUrl={counterpartUrl}
  disableDefaultJsonLd={true}
>

  <BroadcastJsonLd
    slot="head"
    title={item.data.title}
    description={item.data.description}
    pubDate={item.data.pubDate}
    canonicalUrl={canonicalUrl}
    lang="en"
    youtubeId={item.data.youtubeId}
    spotifyUrl={item.data.spotifyUrl}
    duration={item.data.duration}
    thumbnail={item.data.thumbnail}
    chapters={item.data.chapters}
    downloads={item.data.downloads}
  />

  <main class="max-w-4xl mx-auto px-4 sm:px-6 py-12 space-y-10">
    <!-- Breadcrumb Navigation -->
    <nav class="flex items-center gap-2 text-xs font-mono text-text-muted" aria-label="Breadcrumbs">
      <a href="/" class="hover:text-gold-tungsten transition-colors">Home</a>
      <span>/</span>
      <a href="/broadcasts/" class="hover:text-gold-tungsten transition-colors">Broadcasts</a>
      <span>/</span>
      <span class="text-gold-tungsten truncate">{item.data.title}</span>
    </nav>

    <!-- Header Section -->
    <header class="space-y-4">
      <div class="flex items-center gap-3 flex-wrap text-xs font-mono text-text-muted">
        <time datetime={item.data.pubDate.toISOString()} class="text-gold-tungsten">
          {item.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
        {item.data.duration && (
          <>
            <span>•</span>
            <span class="px-2 py-0.5 rounded bg-obsidian-surface border border-obsidian-border text-gold-highlight">
              {item.data.duration.replace('PT', '').toLowerCase()}
            </span>
          </>
        )}
        {counterpartSlug && (
          <>
            <span>•</span>
            <a
              href={`/tr/broadcasts/${counterpartSlug}/`}
              class="text-xs font-mono text-gold-tungsten hover:text-gold-highlight underline decoration-gold-tungsten/40 underline-offset-4 transition-colors"
            >
              Türkçe versiyonunu oku ↗
            </a>
          </>
        )}
      </div>

      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-text-primary leading-snug">
        {item.data.title}
      </h1>

      <p class="text-base sm:text-lg text-text-muted leading-relaxed">
        {item.data.description}
      </p>

      <div class="flex items-center gap-2 flex-wrap pt-2">
        {item.data.tags.map((tag) => (
          <span class="text-xs font-mono text-text-muted px-2.5 py-1 rounded-md bg-obsidian-surface border border-obsidian-border">
            #{tag}
          </span>
        ))}
      </div>
    </header>

    <!-- Case 1: Video Hero (if video is available) -->
    {hasVideo && (
      <section aria-label="Video Player and Chapters">
        <LiteYouTube
          youtubeId={item.data.youtubeId!}
          title={item.data.title}
          chapters={item.data.chapters}
          lang="en"
        />
      </section>
    )}

    <!-- Case 1.5: Editorial Article Cover / Hero Image (if no video and thumbnail exists) -->
    {!hasVideo && item.data.thumbnail && (
      <section class="relative aspect-video rounded-2xl overflow-hidden border border-obsidian-border bg-obsidian-black shadow-2xl group" aria-label="Cover Image">
        <img
          src={item.data.thumbnail}
          alt={item.data.title}
          class="w-full h-full object-cover opacity-90 transition-transform duration-700 group-hover:scale-105"
          loading="eager"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-obsidian-black/60 via-transparent to-transparent pointer-events-none"></div>
      </section>
    )}

    <!-- Case 2: Audio Hero / Banner -->
    {hasAudio && (
      <section class={`p-5 rounded-xl border ${hasVideo ? 'border-emerald-900/40 bg-emerald-950/20' : 'border-emerald-700/50 bg-emerald-950/30 p-6 shadow-xl'} flex flex-col sm:flex-row items-center justify-between gap-4`}>
        <div class="flex items-center gap-3.5 text-emerald-400">
          <div class="p-3 rounded-full bg-emerald-900/40 text-emerald-400 shrink-0">
            <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.503 17.306c-.215.353-.674.464-1.027.249-2.812-1.718-6.353-2.107-10.523-1.155-.403.092-.806-.157-.899-.56-.092-.403.157-.806.56-.899 4.568-1.044 8.508-.598 11.64 1.338.353.215.464.674.249 1.027zm1.47-3.267c-.27.441-.849.58-1.29.31-3.219-1.979-8.127-2.551-11.935-1.394-.497.151-1.024-.136-1.175-.633-.151-.497.136-1.024.633-1.175 4.354-1.321 9.771-.685 13.457 1.579.441.27.58.849.31 1.29zm.126-3.41c-3.86-2.292-10.222-2.503-13.9-1.386-.59.179-1.221-.161-1.4-.751-.179-.59.161-1.221.751-1.4 4.237-1.286 11.266-1.042 15.706 1.593.531.315.704 1.004.389 1.535-.315.531-1.004.704-1.535.389z"/>
            </svg>
          </div>
          <div class="space-y-0.5">
            <h2 class="text-sm sm:text-base font-semibold text-text-primary">
              {hasVideo ? 'Audio Edition Available' : 'Podcast Audio Broadcast'}
            </h2>
            <p class="text-xs text-text-muted">
              Stream on Spotify for Creators, Apple Podcasts, or your favorite client.
            </p>
          </div>
        </div>

        <a
          href={item.data.spotifyUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="px-4 py-2.5 rounded-lg bg-emerald-500 text-obsidian-black font-semibold text-xs hover:bg-emerald-400 transition-colors shrink-0 shadow-lg shadow-emerald-500/20"
        >
          Stream on Spotify ↗
        </a>
      </section>
    )}

    <!-- Case 3: 20TB Google Drive Download Vault -->
    {hasDownloads && (
      <section aria-label="Project Download Vault">
        <DriveDownloadCard downloads={item.data.downloads} lang="en" />
      </section>
    )}

    <!-- Top-Level System Architecture Topology (if provided in frontmatter) -->
    {item.data.mermaidTopology && (
      <div class="mermaid-wrapper my-10 p-6 sm:p-8 rounded-2xl bg-obsidian-surface border border-obsidian-border overflow-x-auto shadow-2xl">
        <div class="text-xs font-mono text-gold-tungsten uppercase tracking-wider mb-4 flex items-center justify-between border-b border-obsidian-border/60 pb-3">
          <span class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-gold-tungsten animate-pulse"></span>
            <span>System Architecture Topology</span>
          </span>
          <span class="text-[11px] text-text-muted lowercase font-mono">interactive vector diagram</span>
        </div>
        <pre class="mermaid">{item.data.mermaidTopology}</pre>
      </div>
    )}

    <!-- Markdown Article & Deep Transcript Body -->
    <article class="prose prose-invert prose-gold max-w-none pt-6 border-t border-obsidian-border/60">
      <Content />
    </article>
  </main>

  <!-- Client-side Interactive Vector Mermaid Topology Renderer -->
  <script is:inline>
    // 1. Process any markdown code blocks with language "mermaid"
    const rawMermaidBlocks = document.querySelectorAll('pre[data-language="mermaid"], pre.mermaid');
    
    rawMermaidBlocks.forEach((el) => {
      const code = el.innerText || el.textContent || '';
      if (!code.trim()) return;

      const pre = document.createElement('pre');
      pre.className = 'mermaid';
      pre.textContent = code.trim();

      const wrapper = document.createElement('div');
      wrapper.className = 'mermaid-wrapper my-8 p-6 sm:p-8 rounded-2xl bg-obsidian-surface border border-obsidian-border overflow-x-auto shadow-2xl';
      
      const header = document.createElement('div');
      header.className = 'text-xs font-mono text-gold-tungsten uppercase tracking-wider mb-4 flex items-center justify-between border-b border-obsidian-border/60 pb-3';
      header.innerHTML = `
        <span class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-gold-tungsten animate-pulse"></span>
          <span>System Architecture Topology</span>
        </span>
        <span class="text-[11px] text-text-muted lowercase font-mono">interactive vector diagram</span>
      `;
      
      wrapper.appendChild(header);
      wrapper.appendChild(pre);

      if (el.parentElement) {
        el.parentElement.replaceChild(wrapper, el);
      }
    });

    // 2. Initialize and render all .mermaid elements
    const mermaidNodes = document.querySelectorAll('.mermaid');
    if (mermaidNodes.length > 0) {
      import('https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs').then((m) => {
        m.default.initialize({
          startOnLoad: false,
          theme: 'base',
          themeVariables: {
            darkMode: true,
            background: '#08090A',
            primaryColor: '#14171D',
            primaryTextColor: '#EDEDED',
            primaryBorderColor: '#C58A3A',
            lineColor: '#D6A354',
            secondaryColor: '#0E1013',
            tertiaryColor: '#1B1E24',
            fontFamily: 'ui-sans-serif, system-ui, sans-serif'
          }
        });
        m.default.run({
          nodes: Array.from(document.querySelectorAll('.mermaid'))
        }).catch((err) => {
          console.warn('Mermaid rendering notice:', err);
        });
      });
    }
  </script>
</BaseLayout>
