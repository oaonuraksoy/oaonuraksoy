---
import BaseLayout from '../../layouts/BaseLayout.astro';

const faqs = [
  {
    question: "What differentiates your systems architecture from typical agency 'custom software'?",
    answer: "Most local web agencies label their work as 'custom software' while merely packaging off-the-shelf WordPress setups or third-party PHP scripts with superficial CSS tweaks. This inflates database overhead and fails under real production concurrency. I build zero-dependency, bespoke software systems from scratch using TypeScript, Astro, Rust, and .NET 8, tailored specifically to your organization's business logic with zero technical debt."
  },
  {
    question: "Who owns the source code and intellectual property upon delivery?",
    answer: "Your organization holds 100% ownership of the entire source code repository, relational database schemas, and architectural documentation. There are no proprietary license lock-ins, artificial framework dependencies, or recurring retainers. Any competent senior engineering team can inspect, build, and extend the system independently."
  },
  {
    question: "Can your web software bridge into existing desktop software, ERPs, or local-area hardware?",
    answer: "Yes. Leveraging the local-first socket and IPC patterns I engineered for oaPOS and oa_sip_recorder, I build deterministic bridges between modern web interfaces and on-premise infrastructure. This includes offline-first LAN networks, serial port hardware (scales, barcode scanners, printers), and enterprise ERP databases such as SAP, Logo, or Mikro."
  },
  {
    question: "How do you incorporate AI workflows and deterministic automations into business logic?",
    answer: "Rather than treating AI as a superficial customer chat widget, I embed multimodal models into operational pipelines—such as automating order classification, parsing technical procurement specifications, forecasting inventory, and preparing multilingual RFQ responses with deterministic safeguards that eliminate hallucination risks."
  },
  {
    question: "How do your architectures comply with enterprise IT and cybersecurity audits?",
    answer: "Every system is constructed to satisfy OWASP Top 10 security standards, strict data protection compliance (KVKK/GDPR), and Zero-Trust principles. With static code auditing, strict Content Security Policies (CSP), and role-based access control (RBAC), the architecture passes corporate IT security screenings seamlessly."
  }
];

const title = "Ankara Custom Software & AI Automation | Onur Aksoy";
const name = "Ankara Custom Software Development, ERP Integration & AI Automation";
const description = "Custom web software development, ERP/API integration and deterministic AI (MCP) automation in Ankara. 100% source code ownership on TypeScript, Rust and .NET.";
const counterpartUrl = "/ankara-web-yazilim/";
const ogImage = "https://onuraksoy.com.tr/images/services/ankara-web-yazilim.webp";
---

