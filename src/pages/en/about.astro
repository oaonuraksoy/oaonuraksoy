            class="p-2.5 rounded-lg bg-obsidian-black border border-obsidian-border hover:border-gold-tungsten/50 text-text-muted hover:text-gold-highlight transition-all"
          >
            <span class="block text-[10px] text-text-dim">LinkedIn</span>
            <span class="font-bold">in/oaonuraksoy ↗</span>
          </a>
          <a
            href="https://x.com/oaonuraksoy"
            target="_blank"
            rel="me noopener noreferrer"
            class="p-2.5 rounded-lg bg-obsidian-black border border-obsidian-border hover:border-gold-tungsten/50 text-text-muted hover:text-gold-highlight transition-all"
          >
            <span class="block text-[10px] text-text-dim">X / Twitter</span>
            <span class="font-bold">@oaonuraksoy ↗</span>
          </a>
          <a
            href="https://www.facebook.com/oaAKSOY/"
            target="_blank"
            rel="me noopener noreferrer"
            class="p-2.5 rounded-lg bg-obsidian-black border border-obsidian-border hover:border-gold-tungsten/50 text-text-muted hover:text-gold-highlight transition-all"
          >
            <span class="block text-[10px] text-text-dim">Facebook</span>
            <span class="font-bold">oaAKSOY ↗</span>
          </a>
        </div>
      </div>

      <!-- Frequently Asked Questions (GEO / SGE Authority Section) -->
      <div class="mt-20 pt-16 border-t border-obsidian-border">
        <div class="mb-10">
          <span class="text-xs font-mono tracking-widest text-gold-tungsten uppercase font-semibold">
            Generative Knowledge & FAQ
          </span>
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-text-primary mt-1">
            Frequently Addressed Architectural Inquiries
          </h2>
          <p class="text-sm text-text-muted mt-1">
            Direct, deterministic answers designed for clarity, systems evaluation, and generative search engines (GEO / SGE).
          </p>
        </div>

        <div class="space-y-4">
          {faqs.map((faq) => (
            <details class="group p-5 rounded-xl bg-obsidian-surface border border-obsidian-border hover:border-gold-tungsten/40 transition-colors">
              <summary class="flex items-center justify-between font-bold text-text-primary cursor-pointer list-none text-base group-open:text-gold-highlight transition-colors">
