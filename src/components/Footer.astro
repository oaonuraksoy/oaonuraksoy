---
interface Props {
  lang?: 'en' | 'tr';
}

const { lang = 'en' } = Astro.props;
const currentYear = new Date().getFullYear();

const socialLinks = [
  { name: 'GitHub', href: 'https://github.com/oaonuraksoy', icon: 'github' },
  { name: 'X / Twitter', href: 'https://x.com/oaonuraksoy', icon: 'x' },
  { name: 'LinkedIn', href: 'https://linkedin.com/in/oaonuraksoy', icon: 'linkedin' },
  { name: 'YouTube', href: 'https://youtube.com/@oaonuraksoy', icon: 'youtube' },
  { name: 'Instagram', href: 'https://instagram.com/oaonuraksoy', icon: 'instagram' },
  { name: 'Telegram', href: 'https://t.me/oaonuraksoy', icon: 'telegram' },
  { name: 'WhatsApp', href: 'https://wa.me/905511817053', icon: 'whatsapp' },
];
---

<footer class="border-t border-obsidian-border bg-obsidian-surface/80 mt-20 transition-colors">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <!-- Top Grid -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 pb-10 border-b border-obsidian-border/60">
      <!-- Col 1: Bio & Manifesto -->
      <div class="md:col-span-6 space-y-4">
        <div class="flex items-center gap-3">
          <img
            src="/images/oa-logo-header.webp"
            alt="Onur Aksoy"
            class="h-8 w-auto object-contain opacity-90"
            width="150"
            height="32"
            loading="lazy"
          />
        </div>
        <p class="text-sm text-text-muted max-w-md leading-relaxed">
          {lang === 'tr' 
            ? 'Yapay zeka yerel mimariler, yerel öncelikli dağıtık masaüstü sistemleri ve yüksek hızlı dijital araçlar üreten kıdemli geliştirici & yaratıcı.' 
            : 'Senior architect and multidisciplinary creator engineering AI-native systems, local-first distributed desktop software, and high-performance digital tools.'}
        </p>

        <!-- Availability Status Pill -->
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-obsidian-black border border-obsidian-border text-xs">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span class="text-text-muted font-mono">
            {lang === 'tr' ? 'Yeni Girişimler & Danışmanlık İçin Açık' : 'Available for Strategic Initiatives & Advisory'}
          </span>
        </div>
      </div>

      <!-- Col 2: Spotify Podcast Feature -->
      <div class="md:col-span-3 space-y-3">
        <h4 class="text-xs uppercase tracking-widest text-gold-tungsten font-semibold font-mono">
          {lang === 'tr' ? 'Podcast & Ses' : 'Podcast & Audio'}
        </h4>
        <a
          href="https://creators.spotify.com/pod/profile/oaonuraksoy/"
          target="_blank"
          rel="noopener noreferrer"
          class="group block p-3 rounded-lg bg-obsidian-black border border-obsidian-border hover:border-gold-tungsten/50 transition-all duration-200"
        >
          <div class="flex items-center gap-3">
            <div class="p-2 rounded-md bg-emerald-950/40 text-emerald-400 group-hover:scale-110 transition-transform">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.503 17.306c-.215.353-.674.464-1.027.249-2.812-1.718-6.353-2.107-10.523-1.155-.403.092-.806-.157-.899-.56-.092-.403.157-.806.56-.899 4.568-1.044 8.508-.598 11.64 1.338.353.215.464.674.249 1.027zm1.47-3.267c-.27.441-.849.58-1.29.31-3.219-1.979-8.127-2.551-11.935-1.394-.497.151-1.024-.136-1.175-.633-.151-.497.136-1.024.633-1.175 4.354-1.321 9.771-.685 13.457 1.579.441.27.58.849.31 1.29zm.126-3.41c-3.86-2.292-10.222-2.503-13.9-1.386-.59.179-1.221-.161-1.4-.751-.179-.59.161-1.221.751-1.4 4.237-1.286 11.266-1.042 15.706 1.593.531.315.704 1.004.389 1.535-.315.531-1.004.704-1.535.389z"/>
              </svg>
            </div>
            <div>
              <div class="text-xs font-semibold text-text-primary group-hover:text-gold-highlight transition-colors">
                Onur Aksoy Podcast
              </div>
              <div class="text-[11px] text-text-dim">
                Spotify for Creators
              </div>
            </div>
          </div>
        </a>
      </div>

      <!-- Col 3: Network & SameAs -->
      <div class="md:col-span-3 space-y-3">
        <h4 class="text-xs uppercase tracking-widest text-gold-tungsten font-semibold font-mono">
          {lang === 'tr' ? 'Dijital Ağ & Kanallar' : 'Digital Footprint & Channels'}
        </h4>
        <div class="grid grid-cols-2 gap-2 text-xs">
          {socialLinks.map((item) => (
            <a
              href={item.href}
              target="_blank"
              rel="noopener noreferrer"
              class="text-text-muted hover:text-gold-highlight hover:underline decoration-gold-tungsten/40 underline-offset-4 transition-colors flex items-center gap-1.5 py-0.5"
            >
              <span>{item.name}</span>
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-text-dim">
      <div class="flex items-center gap-3">
        <span>© {currentYear} Onur Aksoy.</span>
        <span>•</span>
        <span>Ankara, TR / Remote</span>
      </div>

      <div class="flex items-center gap-4">
        <a href="/llms.txt" class="text-text-dim hover:text-gold-tungsten font-mono transition-colors">llms.txt</a>
        <span>•</span>
        <a href="/robots.txt" class="text-text-dim hover:text-gold-tungsten font-mono transition-colors">robots.txt</a>
        <span>•</span>
        <a href="/sitemap-index.xml" class="text-text-dim hover:text-gold-tungsten font-mono transition-colors">sitemap</a>
      </div>
    </div>
  </div>
</footer>
