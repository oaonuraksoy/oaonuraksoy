---
/**
 * SEO.astro — <head> meta, canonical, hreflang, Open Graph ve Twitter Card (AGENTS.md §7.2).
 * - og:image daima 1200×630 JPG paylaşım sürümüdür (public/images/og/); boyut/MIME dosyadan okunur.
 * - Tarih meta'ları (article:*) git geçmişinden gelir; build anı yazılmaz.
 * - rel="me" listesi src/data/identity.mjs'den gelir.
 */
import { SITE_URL, REL_ME, DEFAULT_OG_IMAGE } from '../data/identity.mjs';
import { imageMeta, ogVariant } from '../utils/image-meta.mjs';
import { lastModified } from '../utils/content-dates.mjs';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  canonicalUrl?: string;
  counterpartUrl?: string;
  lang?: 'en' | 'tr';
  type?: 'website' | 'article' | 'profile';
  article?: { publishedTime: string; tags?: string[] };
  citation?: {
    title: string;
    author: string;
    authorOrcid?: string;
    authorInstitution?: string;
    publicationDate: string; // YYYY/MM/DD
    doi: string;
    pdfUrl: string;          // https://onuraksoy.com.tr/papers/*.pdf
    abstractHtmlUrl: string;
    language?: string;
    technicalReportInstitution?: string;
    keywords?: string[];
  };
}

const {
  title,
  description,
  image = DEFAULT_OG_IMAGE,
  imageAlt,
  canonicalUrl = new URL(Astro.url.pathname, SITE_URL).href,
  counterpartUrl,
  lang = 'tr',
  type = 'website',
  article,
  citation
} = Astro.props;

// ── hreflang çiftleri ────────────────────────────────────────────────────────
const pathname = Astro.url.pathname;
let enPath = pathname;
let trPath = pathname;
if (counterpartUrl) {
  if (lang === 'tr') enPath = counterpartUrl;
  else trPath = counterpartUrl;
} else if (pathname.startsWith('/en')) {
  trPath = pathname.replace(/^\/en(\/|$)/, '/') || '/';
} else {
  enPath = pathname === '/' ? '/en/' : `/en${pathname.endsWith('/') ? pathname : pathname + '/'}`;
}
const enUrl = new URL(enPath, SITE_URL).href;
const trUrl = new URL(trPath, SITE_URL).href;

// ── Open Graph görseli (gerçek boyut + MIME) ─────────────────────────────────
let og = imageMeta(ogVariant(image));
if (!og.exists || !og.width) og = imageMeta(DEFAULT_OG_IMAGE);
const ogAlt = imageAlt || title;

// ── Makale tarihleri ─────────────────────────────────────────────────────────
let modifiedTime: string | undefined;
if (article) {
  const lm = lastModified(pathname);
  modifiedTime = lm && Date.parse(lm) > Date.parse(article.publishedTime) ? lm : article.publishedTime;
}
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<meta name="generator" content={Astro.generator} />

<!-- Robots -->
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content="Onur Aksoy (Hackonomist)" />
<meta name="theme-color" content="#08090A" />

<!-- Canonical & Hreflang -->
<link rel="canonical" href={canonicalUrl} />
<link rel="alternate" hreflang="tr" href={trUrl} />
<link rel="alternate" hreflang="en" href={enUrl} />
<link rel="alternate" hreflang="x-default" href={trUrl} />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content="Onur Aksoy" />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={og.url} />
<meta property="og:image:secure_url" content={og.url} />
{og.type && <meta property="og:image:type" content={og.type} />}
<meta property="og:image:width" content={String(og.width)} />
<meta property="og:image:height" content={String(og.height)} />
<meta property="og:image:alt" content={ogAlt} />
<meta property="og:locale" content={lang === 'tr' ? 'tr_TR' : 'en_US'} />
<meta property="og:locale:alternate" content={lang === 'tr' ? 'en_US' : 'tr_TR'} />
{article && <meta property="article:published_time" content={article.publishedTime} />}
{article && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
{article && <meta property="article:author" content={`${SITE_URL}${lang === 'tr' ? '/about/' : '/en/about/'}`} />}
{article?.tags?.map((tag) => <meta property="article:tag" content={tag} />)}

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@oaonuraksoy" />
<meta name="twitter:creator" content="@oaonuraksoy" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={og.url} />
<meta name="twitter:image:alt" content={ogAlt} />

{citation && (
  <>
    <!-- Google Scholar / Highwire Press Metadata -->
    <meta name="citation_title" content={citation.title} />
    <meta name="citation_author" content={citation.author} />
    {citation.authorOrcid && <meta name="citation_author_orcid" content={citation.authorOrcid} />}
    {citation.authorInstitution && <meta name="citation_author_institution" content={citation.authorInstitution} />}
    <meta name="citation_publication_date" content={citation.publicationDate} />
    <meta name="citation_online_date" content={citation.publicationDate} />
    <meta name="citation_doi" content={citation.doi} />
    <meta name="citation_pdf_url" content={citation.pdfUrl} />
    <meta name="citation_abstract_html_url" content={citation.abstractHtmlUrl} />
    {citation.technicalReportInstitution && <meta name="citation_technical_report_institution" content={citation.technicalReportInstitution} />}
    <meta name="citation_language" content={citation.language || 'en'} />
    {citation.keywords && citation.keywords.length > 0 && <meta name="citation_keywords" content={citation.keywords.join('; ')} />}
  </>
)}

<!-- Yerel varlık sinyalleri -->
<meta name="geo.region" content="TR-06" />
<meta name="geo.placename" content="Ankara" />

<!-- Kimlik doğrulama (rel=me) — src/data/identity.mjs -->
<link rel="author" href={`${SITE_URL}${lang === 'tr' ? '/about/' : '/en/about/'}`} />
{REL_ME.map((href) => <link rel="me" href={href} />)}

<!-- Keşif uç noktaları -->
<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title="Onur Aksoy — RSS" href={`${SITE_URL}/rss.xml`} />
<link rel="hub" href="https://pubsubhubbub.appspot.com/" />
