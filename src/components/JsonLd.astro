---
interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  type?: 'Person' | 'WebSite' | 'SoftwareApplication' | 'Article';
  title?: string;
  description?: string;
  url?: string;
  image?: string;
  datePublished?: string;
  lang?: 'en' | 'tr';
  faqs?: FAQItem[];
}

const siteUrl = 'https://onuraksoy.com.tr';

const {
  type = 'Person',
  title = 'Onur Aksoy — AI-Native Developer & Multidisciplinary Creator',
  description = 'Personal portfolio and technical case studies of Onur Aksoy. Pioneering deterministic AI architectures, local-first software, and high-performance digital tools.',
  url,
  image = 'https://onuraksoy.com.tr/images/onur-aksoy.webp',
  datePublished,
  lang = 'en',
  faqs
} = Astro.props;

const pathname = Astro.url ? Astro.url.pathname : '/';
const resolvedUrl = url || new URL(pathname, siteUrl).href;
const isTr = lang === 'tr' || pathname.startsWith('/tr');
const homeUrl = isTr ? `${siteUrl}/tr/` : `${siteUrl}/`;

const resolvedImageUrl = image.startsWith('http') ? image : `${siteUrl}${image.startsWith('/') ? image : '/' + image}`;

// 1. Person Entity
const personSchema: any = {
  '@type': 'Person',
  '@id': `${siteUrl}/#person`,
  name: 'Onur Aksoy',
  alternateName: ['Hackonomist', 'hackonomist', 'OA', 'Onur Aksoy (Hackonomist)'],
  givenName: 'Onur',
  familyName: 'Aksoy',
  jobTitle: 'AI-Native Developer & Multidisciplinary Creator',
  description: isTr 
    ? 'Onur Aksoy (a.k.a. Hackonomist); yapay zeka yerel mimariler, yerel öncelikli (local-first) masaüstü yazılımları, dijital büyüme ve hackonomik otomasyon sistemleri üreten kıdemli geliştirici ve yaratıcıdır.' 
    : 'Onur Aksoy (a.k.a. Hackonomist) is an AI-native systems architect, local-first software developer, and multidisciplinary creator building resilient tools, deterministic agentic systems, and digital growth infrastructure.',
  url: siteUrl,
  image: {
    '@type': 'ImageObject',
    '@id': `${siteUrl}/#primaryimage`,
    url: `${siteUrl}/images/onur-aksoy.webp`,
    caption: 'Onur Aksoy',
    inLanguage: isTr ? 'tr-TR' : 'en-US'
  },
  email: 'mailto:dev@onuraksoy.com.tr',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Ankara',
    addressCountry: 'TR'
  },
  sameAs: [
    'https://github.com/oaonuraksoy',
    'https://x.com/oaonuraksoy',
    'https://linkedin.com/in/oaonuraksoy',
    'https://youtube.com/@oaonuraksoy',
    'https://instagram.com/oaonuraksoy',
    'https://t.me/oaonuraksoy',
    'https://wa.me/905511817053',
    'https://creators.spotify.com/pod/profile/oaonuraksoy/'
  ],
  knowsAbout: [
    'Artificial Intelligence Architecture',
    'Deterministic Agent Orchestration',
    'Local-First Software',
    'Astro 7 & Static Web',
    '.NET & WPF Desktop Systems',
    'Distributed LAN Sockets',
    'TypeScript & Web Components',
    'Generative Diffusion Models'
  ]
};

// 2. WebSite Entity with Google SearchAction
const websiteSchema: any = {
  '@type': 'WebSite',
  '@id': `${siteUrl}/#website`,
  url: siteUrl,
  name: 'Onur Aksoy',
  alternateName: ['Onur Aksoy Portfolio', 'OA Portfolyo'],
  description: description,
  inLanguage: ['en-US', 'tr-TR'],
  primaryImageOfPage: {
    '@id': `${siteUrl}/#primaryimage`
  },
  publisher: {
    '@id': `${siteUrl}/#person`
  },
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: 'https://www.google.com/search?q=site:onuraksoy.com.tr+{search_term_string}'
    },
    'query-input': 'required name=search_term_string'
  }
};

// 3. Primary ImageObject
const imageSchema: any = {
  '@type': 'ImageObject',
  '@id': `${siteUrl}/#primaryimage`,
  name: title,
  caption: isTr 
    ? 'Onur Aksoy — Yapay Zeka Yerel Geliştirici & Çok Disiplinli Yaratıcı' 
    : 'Onur Aksoy — AI-Native Developer & Multidisciplinary Creator',
  contentUrl: resolvedImageUrl,
  url: resolvedImageUrl,
  width: resolvedImageUrl.includes('onur-aksoy.webp') ? 937 : 1200,
  height: resolvedImageUrl.includes('onur-aksoy.webp') ? 1679 : 630,
  encodingFormat: 'image/webp',
  representativeOfPage: true,
  author: {
    '@id': `${siteUrl}/#person`
  },
  creator: {
    '@id': `${siteUrl}/#person`
  },
  inLanguage: isTr ? 'tr-TR' : 'en-US'
};

// 4. BreadcrumbList & WebPage
const isHome = pathname === '/' || pathname === '/tr/' || pathname === '/tr';
const sectionLabels: Record<string, { en: string; tr: string }> = {
  projects: { en: 'Projects', tr: 'Projeler' },
  broadcasts: { en: 'Broadcasts & Technical Vault', tr: 'Yayınlar & Bilgi Kasası' },
  about: { en: 'About & Philosophy', tr: 'Hakkında & Felsefe' },
  contact: { en: 'Contact', tr: 'İletişim' },
  oapos: { en: 'oaPOS', tr: 'oaPOS' },
  'orvyna-app-studio': { en: 'Orvyna App Studio', tr: 'Orvyna App Studio' },
  'ecommerce-image-enhancer': { en: 'E-Commerce Image Enhancer', tr: 'E-Ticaret Görsel Geliştirici' }
};

let breadcrumbSchema: any = null;
if (!isHome) {
  const rawSegments = (isTr ? pathname.replace(/^\/tr(\/|$)/, '') : pathname).split('/').filter(Boolean);

  const itemListElement: any[] = [
    {
      '@type': 'ListItem',
      position: 1,
      name: isTr ? 'Ana Sayfa' : 'Home',
      item: homeUrl
    }
  ];

  if (rawSegments.length >= 1) {
    const seg1 = rawSegments[0];
    const seg1Name = sectionLabels[seg1]?.[isTr ? 'tr' : 'en'] || (rawSegments.length === 1 ? title : seg1.charAt(0).toUpperCase() + seg1.slice(1));
    const seg1Url = `${homeUrl}${seg1}/`;
    itemListElement.push({
      '@type': 'ListItem',
      position: 2,
      name: seg1Name,
      item: seg1Url
    });
  }

  if (rawSegments.length >= 2) {
    const seg2 = rawSegments[1];
    const seg2Name = title || sectionLabels[seg2]?.[isTr ? 'tr' : 'en'] || seg2;
    itemListElement.push({
      '@type': 'ListItem',
      position: 3,
      name: seg2Name,
      item: resolvedUrl
    });
  }

  breadcrumbSchema = {
    '@type': 'BreadcrumbList',
    '@id': `${resolvedUrl}#breadcrumb`,
    itemListElement: itemListElement
  };
}

// 5. WebPage Entity
const webpageSchema: any = {
  '@type': 'WebPage',
  '@id': `${resolvedUrl}#webpage`,
  url: resolvedUrl,
  name: title,
  description: description,
  isPartOf: {
    '@id': `${siteUrl}/#website`
  },
  inLanguage: isTr ? 'tr-TR' : 'en-US'
};

if (breadcrumbSchema) {
  webpageSchema.breadcrumb = {
    '@id': `${resolvedUrl}#breadcrumb`
  };
}

// 6. Custom Schema (SoftwareApplication or Article)
let customSchema: any = null;
if (type === 'SoftwareApplication') {
  customSchema = {
    '@type': 'SoftwareApplication',
    '@id': `${resolvedUrl}#software`,
    name: title,
    description: description,
    url: resolvedUrl,
    image: {
      '@type': 'ImageObject',
      url: resolvedImageUrl
    },
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Windows, Web, Multiplatform',
    author: {
      '@id': `${siteUrl}/#person`
    }
  };
} else if (type === 'Article') {
  customSchema = {
    '@type': 'TechArticle',
    '@id': `${resolvedUrl}#article`,
    isPartOf: {
      '@id': `${resolvedUrl}#webpage`
    },
    headline: title,
    description: description,
    url: resolvedUrl,
    image: {
      '@type': 'ImageObject',
      url: resolvedImageUrl
    },
    datePublished: datePublished,
    author: {
      '@id': `${siteUrl}/#person`
    },
    publisher: {
      '@id': `${siteUrl}/#person`
    },
    inLanguage: isTr ? 'tr-TR' : 'en-US'
  };
}

// 7. FAQ Schema
let faqSchema: any = null;
if (faqs && faqs.length > 0) {
  faqSchema = {
    '@type': 'FAQPage',
    '@id': `${resolvedUrl}#faq`,
    mainEntity: faqs.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer
      }
    }))
  };
}

// Assemble Single @graph Array
const graph: any[] = [
  personSchema,
  websiteSchema,
  imageSchema,
  webpageSchema
];

if (breadcrumbSchema) {
  graph.push(breadcrumbSchema);
}
if (customSchema) {
  graph.push(customSchema);
}
if (faqSchema) {
  graph.push(faqSchema);
}

const schemaData = {
  '@context': 'https://schema.org',
  '@graph': graph
};
---

<script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
