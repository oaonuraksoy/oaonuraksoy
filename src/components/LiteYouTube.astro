---
interface Chapter {
  time: string;
  seconds?: number;
  title: string;
}

interface Props {
  youtubeId: string;
  title: string;
  chapters?: Chapter[];
  lang?: 'en' | 'tr';
}

const { youtubeId, title, chapters = [], lang = 'en' } = Astro.props;

// Convert "MM:SS" or "HH:MM:SS" to seconds
function parseTimeToSeconds(timeStr: string): number {
  const parts = timeStr.split(':').map(Number);
  if (parts.length === 2) {
    return parts[0] * 60 + parts[1];
  } else if (parts.length === 3) {
    return parts[0] * 3600 + parts[1] * 60 + parts[2];
  }
  return 0;
}

const enrichedChapters = chapters.map((ch) => ({
  ...ch,
  seconds: ch.seconds ?? parseTimeToSeconds(ch.time)
}));

const thumbUrl = `https://i.ytimg.com/vi/${youtubeId}/maxresdefault.jpg`;
const ytWatchUrl = `https://www.youtube.com/watch?v=${youtubeId}`;
---

<div class="space-y-6">
  <!-- Lite Player Façade -->
  <div
    class="lite-yt-container relative w-full aspect-video rounded-xl overflow-hidden border border-obsidian-border bg-obsidian-surface shadow-2xl group"
    data-yt-id={youtubeId}
  >
    <!-- Video Poster Image -->
    <img
      src={thumbUrl}
      alt={title}
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105 opacity-90"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-obsidian-black/90 via-obsidian-black/20 to-transparent"></div>

    <!-- Play Action Overlay -->
    <div class="absolute inset-0 flex flex-col items-center justify-center gap-4 p-4 text-center">
      <button
        type="button"
        class="lite-yt-play-btn w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-gold-tungsten/90 text-obsidian-black flex items-center justify-center shadow-lg shadow-gold-tungsten/20 hover:scale-110 hover:bg-gold-highlight transition-all duration-300 focus:outline-none focus-visible:ring-4 focus-visible:ring-gold-highlight"
        aria-label={`${lang === 'tr' ? 'Videoyu oynat' : 'Play video'}: ${title}`}
      >
        <svg class="w-8 h-8 sm:w-10 sm:h-10 fill-current translate-x-0.5" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M8 5v14l11-7z" />
        </svg>
      </button>

      <div class="max-w-lg">
        <div class="text-xs uppercase tracking-widest text-gold-tungsten font-mono font-semibold mb-1">
          {lang === 'tr' ? 'Video Yayını & Canlı İnceleme' : 'Broadcast & Architectural Screencast'}
        </div>
        <p class="text-sm sm:text-base font-semibold text-text-primary line-clamp-2">
          {title}
        </p>
      </div>
    </div>

    <!-- Top Right: Watch directly on YouTube button -->
    <div class="absolute top-4 right-4 z-10">
      <a
        href={ytWatchUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-obsidian-black/80 hover:bg-red-600/90 text-text-primary hover:text-white border border-obsidian-border text-xs font-medium backdrop-blur-sm transition-all duration-200"
      >
        <svg class="w-4 h-4 fill-current text-red-500 group-hover:text-white" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
        </svg>
        <span>{lang === 'tr' ? "YouTube'da Aç ↗" : 'Watch on YouTube ↗'}</span>
      </a>
    </div>
  </div>

  <!-- Chapters & Key Moments (GEO / SGE Booster) -->
  {enrichedChapters.length > 0 && (
    <div class="rounded-xl border border-obsidian-border bg-obsidian-surface p-5 space-y-3">
      <div class="flex items-center justify-between">
        <h2 class="text-xs uppercase tracking-widest text-gold-tungsten font-mono font-semibold flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>{lang === 'tr' ? 'Bölümler & Zaman Damgaları' : 'Key Moments & Chapters'}</span>
        </h2>
        <span class="text-xs text-text-muted font-mono">
          {enrichedChapters.length} {lang === 'tr' ? 'bölüm' : 'chapters'}
        </span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-2">
        {enrichedChapters.map((ch) => (
          <a
            href={`${ytWatchUrl}&t=${ch.seconds}s`}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-between p-2.5 rounded-lg border border-obsidian-border/60 bg-obsidian-black/50 hover:bg-obsidian-subtle hover:border-gold-tungsten/40 transition-all text-xs group"
          >
            <span class="text-text-muted group-hover:text-text-primary transition-colors line-clamp-1 pr-2">
              {ch.title}
            </span>
            <span class="font-mono text-gold-tungsten bg-obsidian-surface px-2 py-0.5 rounded border border-obsidian-border text-[11px] shrink-0 group-hover:text-gold-highlight">
              {ch.time} ↗
            </span>
          </a>
        ))}
      </div>
    </div>
  )}
</div>

<script>
  // Dynamic zero-JS until clicked hydration for the video container
  document.querySelectorAll('.lite-yt-container').forEach((container) => {
    const playBtn = container.querySelector('.lite-yt-play-btn');
    if (!playBtn) return;

    playBtn.addEventListener('click', () => {
      const ytId = container.getAttribute('data-yt-id');
      if (!ytId) return;

      const iframe = document.createElement('iframe');
      iframe.setAttribute('src', `https://www.youtube-nocookie.com/embed/${ytId}?autoplay=1&rel=0`);
      iframe.setAttribute('title', 'YouTube video player');
      iframe.setAttribute('frameborder', '0');
      iframe.setAttribute('allow', 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share');
      iframe.setAttribute('allowfullscreen', 'true');
      iframe.className = 'w-full h-full absolute inset-0';

      container.innerHTML = '';
      container.appendChild(iframe);
    });
  });
</script>
