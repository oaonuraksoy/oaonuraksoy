const t = content[lang];
---

<section id={t.sectionId} class="py-20 border-t border-obsidian-border bg-obsidian-surface/30">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <!-- Header -->
    <div class="mb-12 text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-obsidian-black border border-gold-tungsten/30 mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-gold-highlight"></span>
        <span class="text-xs font-mono text-gold-highlight uppercase tracking-wider">
          {t.badge}
        </span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-text-primary leading-tight">
        {t.title}
      </h2>
      <p class="text-lg sm:text-xl text-gold-highlight font-semibold mt-2">
        {t.subtitle}
      </p>
      <p class="text-xs sm:text-sm text-text-muted mt-2 font-mono">
        {t.authorLine}
      </p>
    </div>

    <!-- Main Grid: Cover on Left, Editorial + Colophon on Right -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
      <!-- Left: Book Cover & Badges -->
      <div class="lg:col-span-5 flex flex-col items-center">
        <div class="relative w-full max-w-xs sm:max-w-sm rounded-2xl overflow-hidden border border-gold-tungsten/40 bg-obsidian-black shadow-2xl shadow-gold-tungsten/10 group">
          <img
            src="/images/books/yapay-zeka-sizi-tanimiyor-kapak.webp"
            alt={t.coverAlt}
            width="640"
            height="1024"
            loading="lazy"
            decoding="async"
            class="w-full h-auto object-cover transition-transform duration-500 group-hover:scale-[1.02]"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-obsidian-black/80 via-transparent to-transparent pointer-events-none"></div>
          <div class="absolute bottom-3 left-3 right-3 flex items-center justify-between text-[11px] font-mono px-3 py-1.5 rounded-lg bg-obsidian-surface/90 border border-obsidian-border backdrop-blur-sm">
            <span class="text-gold-highlight font-semibold">{t.priceTag}</span>
            <span class="text-text-muted">{t.formatsTag}</span>
          </div>
        </div>

        <!-- Quick Trust Badges -->
        <div class="w-full max-w-xs sm:max-w-sm mt-4 grid grid-cols-2 gap-2 text-center">
          <div class="p-2.5 rounded-xl bg-obsidian-surface border border-obsidian-border text-[11px]">
            <span class="block text-text-dim font-mono">{isTr ? 'Format' : 'Format'}</span>
            <span class="text-text-primary font-semibold">{t.formatsTag}</span>
          </div>
          <div class="p-2.5 rounded-xl bg-obsidian-surface border border-gold-tungsten/30 text-[11px]">
            <span class="block text-text-dim font-mono">{isTr ? 'Durum' : 'Status'}</span>
            <span class="text-gold-highlight font-semibold">{t.isbnStatusTag}</span>
          </div>
        </div>
      </div>

      <!-- Right: Editorial Synopsis, Colophon, TOC & Purchasing -->
      <div class="lg:col-span-7 flex flex-col gap-6">
        <!-- Editorial Synopsis -->
        <div class="card-noir p-6 rounded-2xl border border-obsidian-border bg-obsidian-surface/50">
          <h3 class="text-xs font-mono uppercase tracking-wider text-gold-tungsten mb-3">
            {isTr ? 'Eser Tanıtımı & Editoryal Çerçeve' : 'Editorial Synopsis & Architectural Framework'}
          </h3>
          <p class="text-sm text-text-primary leading-relaxed mb-3">
            {t.editorialP1}
          </p>
          <p class="text-sm text-text-muted leading-relaxed">
            {t.editorialP2}
          </p>
        </div>

        <!-- Official EKYGM Colophon Card -->
        <div class="card-noir p-6 rounded-2xl border border-gold-tungsten/30 bg-obsidian-surface/80">
          <div class="flex items-center justify-between gap-4 mb-4 pb-3 border-b border-obsidian-border/70">
            <h3 class="text-xs font-mono uppercase tracking-wider text-gold-highlight font-semibold">
              {t.colophonHeading}
            </h3>
            <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-gold-tungsten/15 text-gold-highlight border border-gold-tungsten/30">
              EKYGM
            </span>
          </div>

          <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3.5 text-xs">
            {t.colophon.map((item) => (
              <div class={item.full ? 'sm:col-span-2' : ''}>
                <dt class="text-text-dim font-mono text-[11px]">{item.label}</dt>
                <dd class="text-text-primary font-medium mt-0.5 leading-snug">{item.value}</dd>
              </div>
            ))}
          </dl>
        </div>

        <!-- Table of Contents (Details / Summary) -->
        <details class="group p-5 rounded-xl bg-obsidian-surface border border-obsidian-border hover:border-gold-tungsten/40 transition-colors">
          <summary class="flex items-center justify-between font-bold text-text-primary cursor-pointer list-none text-sm group-open:text-gold-highlight transition-colors">
            <span class="flex items-center gap-2">
              <span>{t.tocHeading}</span>
              <span class="text-[11px] font-mono font-normal text-text-muted px-2 py-0.5 rounded bg-obsidian-black border border-obsidian-border">
                {t.tocBadge}
              </span>
            </span>
            <span class="text-xs font-mono px-2 py-0.5 rounded bg-obsidian-black border border-obsidian-border text-gold-tungsten group-open:rotate-45 transition-transform duration-200">
              +
            </span>
          </summary>
          <ol class="mt-4 pt-4 border-t border-obsidian-border/50 space-y-2 text-xs text-text-muted font-mono list-decimal list-inside leading-relaxed">
            {t.chapters.map((ch) => (
              <li class="hover:text-text-primary transition-colors">{ch}</li>
            ))}
          </ol>
        </details>

        <!-- Purchasing / Licensing CTA Box -->
        <div class="p-6 rounded-2xl bg-gradient-to-br from-obsidian-surface via-obsidian-surface to-obsidian-black border border-gold-tungsten/40 shadow-xl">
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4 mb-4">
            <div class="flex flex-wrap items-center gap-3">
              <a
                href={t.ctaPrimaryHref}
                class="px-6 py-3.5 rounded-xl font-bold text-sm bg-gold-tungsten text-obsidian-black hover:bg-gold-highlight shadow-lg shadow-gold-tungsten/20 transition-all duration-200 text-center"
              >
                {t.ctaPrimaryText}
              </a>
              <a
                href={BOOK_YAPAY_ZEKA.previewPdfPath}
                target="_blank"
                rel="noopener"
                class="px-5 py-3.5 rounded-xl font-semibold text-sm bg-obsidian-surface border border-gold-tungsten/50 hover:border-gold-highlight text-gold-highlight hover:text-text-primary transition-all duration-200 text-center"
              >
                {t.previewButtonText}
              </a>
            </div>
            <span class="inline-flex items-center justify-center text-xs font-mono text-gold-highlight px-3.5 py-2 rounded-xl bg-obsidian-black border border-obsidian-border text-center">
              {t.storeBadge}
            </span>
          </div>
          <p class="text-xs text-text-dim leading-relaxed">
            {t.orderNote}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
