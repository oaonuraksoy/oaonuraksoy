---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';
import JsonLd from '../components/JsonLd.astro';
import { DEFAULT_OG_IMAGE } from '../data/identity.mjs';
import '../styles/global.css';

interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  /** <title> — en fazla 60 karakter hedeflenir (scripts/check-seo.mjs denetler) */
  title?: string;
  /** meta description — 110–160 karakter */
  description?: string;
  /** Sayfanın görünen adı (H1); JSON-LD ad alanı için kullanılır */
  name?: string;
  image?: string;
  lang?: 'en' | 'tr';
  activeNav?: string;
  counterpartUrl?: string;
  schemaType?: 'Person' | 'WebSite' | 'SoftwareApplication' | 'Article' | 'Service';
  faqs?: FAQItem[];
  itemList?: { name: string; items: { name: string; url: string; description?: string }[] };
  serviceType?: string;
  ogType?: 'website' | 'article' | 'profile';
  article?: { publishedTime: string; tags?: string[] };
  disableDefaultJsonLd?: boolean;
}

const {
  title = 'Onur Aksoy — Yazılım Geliştirici & Sistem Mimarı',
  description = "Onur Aksoy (Hackonomist) — Ankara merkezli Yazılım Geliştirici & Sistem Mimarı. AI-native mimariler, local-first masaüstü yazılımları ve B2B web sistemleri.",
  name,
  image = DEFAULT_OG_IMAGE,
  lang = 'tr',
  activeNav = '',
  counterpartUrl,
  schemaType = 'Person',
  faqs,
  itemList,
  serviceType,
  ogType = 'website',
  article,
  disableDefaultJsonLd = false
} = Astro.props;
---

<!doctype html>
<html lang={lang} class="scroll-smooth bg-obsidian-black text-text-primary">
  <head>
    <SEO
      title={title}
      description={description}
      image={image}
      lang={lang}
      counterpartUrl={counterpartUrl}
      type={ogType}
      article={article}
    />
    {!disableDefaultJsonLd && (
      <JsonLd
        type={schemaType}
        title={title}
        name={name}
        description={description}
        image={image}
        lang={lang}
        faqs={faqs}
        itemList={itemList}
        serviceType={serviceType}
      />
    )}
    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col bg-obsidian-black selection:bg-gold-tungsten selection:text-obsidian-black">
    <!-- Accessibility Skip Link -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 z-50 px-4 py-2 bg-gold-tungsten text-obsidian-black font-semibold rounded-md shadow-lg outline-none"
    >
      {lang === 'tr' ? 'İçeriğe atla' : 'Skip to main content'}
    </a>

    <!-- Cinematic Film Grain Noise Overlay -->
    <div class="film-grain" aria-hidden="true"></div>

    <!-- Ambient Subtle Warm Light at Top -->
    <div class="fixed top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-96 ambient-glow pointer-events-none -z-10" aria-hidden="true"></div>

    <!-- Global Header -->
    <Header lang={lang} activeNav={activeNav} counterpartUrl={counterpartUrl} />

    <!-- Main Content Slot -->
    <main id="main-content" class="flex-grow w-full">
      <slot />
    </main>

    <!-- Global Footer -->
    <Footer lang={lang} />
  </body>
</html>
